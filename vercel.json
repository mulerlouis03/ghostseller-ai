{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/owner",
      "dest": "/owner.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/privacy",
      "dest": "server.js"
    },
    {
      "src": "/terms",
      "dest": "server.js"
    },
    {
      "src": "/contact",
      "dest": "server.js"
    },
    {
      "src": "/tiktok-developers-site-verification.txt",
      "dest": "server.js"
    },
    {
      "src": "/api/stripe-live/webhook",
      "dest": "server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}